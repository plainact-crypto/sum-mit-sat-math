[{"number":1,"group":"Skill Check","question":"Cylinder radius 2, height 3. Find volume in exact π form.","answer":"12π","solution":"V=π×2²×3=12π."},{"number":2,"group":"Skill Check","question":"Cylinder radius 3, height 5. Find volume.","answer":"45π","solution":"V=π×3²×5=45π."},{"number":3,"group":"Skill Check","question":"Cylinder diameter 8, height 2. Find volume.","answer":"32π","solution":"Radius=4; V=π×4²×2=32π."},{"number":4,"group":"Core Practice","question":"Radius 4, height 6. Find volume.","answer":"96π","solution":"π×4²×6=96π."},{"number":5,"group":"Core Practice","question":"Radius 5, height 2. Find volume.","answer":"50π","solution":"π×25×2=50π."},{"number":6,"group":"Core Practice","question":"Closed cylinder radius 3, height 4. Find total surface area.","answer":"42π","solution":"2π×3²+2π×3×4=18π+24π=42π."}]