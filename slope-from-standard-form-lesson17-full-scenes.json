  "english": [
    [
      "Objective",
      "Find slope from Ax+By=C."
    ],
    [
      "Meaning",
      "Slope measures change in y per unit x."
    ],
    [
      "Rule",
      "The slope is -A/B when B is not zero."
    ],
    [
      "Why",
      "Rearrange as y=(-A/B)x+C/B."
    ],
    [
      "Example 1",
      "3x+4y=20 has slope -3/4."
    ],
    [
      "Example 2",
      "-5x+2y=8 has slope 5/2."
    ],
    [
      "Signs",
      "Same-sign coefficients give negative slope."
    ],
    [
      "Special lines",
      "2y=18 has slope zero; 5x=25 has undefined slope."
    ],
    [
      "Fractions",
      "(3/2)x-(9/4)y=6 has slope 2/3."
    ],
    [
      "Application",
      "5t+2T=60 gives slope -5/2 degrees per hour."
    ],
    [
      "Desmos",
      "Graph 3x+4y=20 and verify slope -3/4."
    ],
    [
      "Recap",
      "Find A and B, compute -A/B, check signs."
    ]
