{"slug":"initial-value","groups":[3,8,5,2],"questions":[["f(x)=7(1.2)^x. Find f(0).",["7","1.2","8.4","0"],0,"(1.2)^0=1, so f(0)=7."],["P(t)=150(0.8)^t. Find P(0).",["120","150","0.8","187.5"],1,"150(0.8)^0=150."],["An exponential graph passes through (0,42). Find its initial value.",["0","21","42","84"],2,"At x=0 the output is 42."],["g(x)=3·2^(x+1). Find g(0).",["3","6","2","12"],1,"3·2^(0+1)=6."],["h(x)=80(1/2)^(x−2). Find h(0).",["20","40","160","320"],3,"80(1/2)^(−2)=80·4=320."],["A table gives (0,12),(1,18),(2,27). Find the initial value.",["12","18","27","1.5"],0,"At input zero the output is 12."],["f(1)=30, f(2)=45 in an exponential model. Find f(0).",["15","20","30","67.5"],1,"Factor=45/30=1.5; f(0)=30/1.5=20."],["S(t)=500(1.03)^t. What does 500 represent?",["Annual rate","One-year balance","Initial savings","Yearly dollar gain"],2,"S(0)=500."],["y=4·3^(x−2). Find y at x=0.",["4/9","4/3","4","36"],0,"4·3^(−2)=4/9."],["P(t)=250(0.9)^(t+1). Find P(0).",["250","225","275","202.5"],1,"250·0.9=225."],["f(0)=32 and f(1)=40. Which exponential model fits?",["32(1.25)^t","40(1.25)^t","32(0.8)^t","32+8t"],0,"Initial=32; factor=40/32=1.25."],["f(2)=72 and growth factor=1.5. Find f(0).",["24","32","48","108"],1,"72/(1.5)^2=32."],["f(−1)=12 and growth factor=2. Find f(0).",["6","12","24","48"],2,"Move forward one period: 12·2=24."],["P(t)=a(1.04)^t and P(2)=540.8. Find a.",["500","520","540.8","562.432"],0,"a=540.8/(1.04)^2=500."],["f(x)=c(0.5)^x+9 and f(0)=25. Find c.",["9","16","25","34"],1,"c+9=25, so c=16."],["A(t)=90(1.1)^t, B(t)=60(1.5)^t. Find A(0)−B(0).",["15","20","30","45"],2,"90−60=30."],["A 12%-growth investment is worth $1,254.40 after 2 years. Find its starting value.",["$1,000","$1,120","$1,200","$1,254.40"],0,"1254.40/(1.12)^2=1000."],["h(x)=k(1/2)^(x−2)+3 and h(0)=35. Find k.",["4","8","16","32"],1,"4k+3=35, so k=8."]]}
