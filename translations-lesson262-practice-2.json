[{"number":4,"group":"Core Practice","question":"Translate R(7,-1) by vector (-5,3).","answer":"(2,2)","solution":"The image is (7-5,-1+3)=(2,2)."},{"number":5,"group":"Core Practice","question":"Apply T(x,y)=(x+6,y-1) to S(-2,4).","answer":"(4,3)","solution":"The image is (-2+6,4-1)=(4,3)."},{"number":6,"group":"Core Practice","question":"Find the vector from B(-4,6) to B'(2,1).","answer":"(6,-5)","solution":"The changes are 2-(-4)=6 and 1-6=-5."}]